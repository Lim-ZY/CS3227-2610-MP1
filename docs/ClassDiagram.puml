@startuml TimeyClassDiagram
title Timey production class diagram

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "Timey" {
  class Timey <<composition root>>
}

package "ui" {
  class CommandLineApp
  class ConsoleUi
  class DashboardState <<record>>
  abstract class UiPart
}

package "ui.dashboard" {
  class DashboardLauncher
  class TimeyDashboardApp
  class MainWindow
  class DashboardHeader
  class CommandBar
  class CommandOutput
  class NextEventCard
  class CommuteStatusCard
  class RouteAlternativesPanel
}

package "parser" {
  class Parser
  class PlanCommandParser
  class AddCommandParser
}

package "planner" {
  class Planner
  class "Planner.PlanningResult" as PlanningResult <<record>>
  class CommutePlanningService
  class LiveRailPlanningService
}

package "model" {
  class TimeyModel
  class RouteSelectionResult <<record>>
  enum "RouteSelectionResult.Status" as RouteSelectionStatus
}

package "command" {
  abstract class Command
  class CommandResult <<record>>
  class ThanksCommand
  class AddCommand
  class PlanCommand
  class ChooseCommand
  class UnknownCommand
}

package "domain.alert" {
  class DepartureCalculator
  class DepartureRecommendation <<record>>
}

package "domain.location" {
  class LocationResolution <<record>>
  class ResolvedLocation <<record>>
}

package "domain.transit" {
  class FixedCommute <<record>>
  class RouteAlternative <<record>>
  class RouteStep <<record>>
  enum RouteStepMode
  class LiveRouteLookup <<record>>
}

package "ports" {
  interface FixedCommuteStore
  interface LocationResolver
  interface TransitPlanner
  interface RailTransitPlanner
}

package "infrastructure.http" {
  interface HttpRequester
  class HttpResult <<record>>
  class JdkHttpRequester
  class RetryingHttpRequester
  interface RetryDelay
}

package "infrastructure.location" {
  class OneMapLocationResolver
}

package "infrastructure.transit" {
  class MockTransitPlanner
  class OneMapRailTransitPlanner
}

package "config" {
  class ApplicationConfiguration
}

' Application composition and presentation flow
Timey *--> ConsoleUi
Timey *--> CommandLineApp
Timey *--> ApplicationConfiguration
Timey *--> CommutePlanningService
Timey *--> PlanCommandParser
Timey *--> JdkHttpRequester
Timey *--> RetryingHttpRequester
Timey *--> OneMapLocationResolver
Timey *--> OneMapRailTransitPlanner
Timey *--> MockTransitPlanner

CommandLineApp --> ConsoleUi
CommandLineApp --> DashboardState : produces
DashboardLauncher --> TimeyDashboardApp : launches
TimeyDashboardApp --> MainWindow : creates
TimeyDashboardApp --> CommandLineApp : composes
MainWindow --|> UiPart
DashboardHeader --|> UiPart
CommandBar --|> UiPart
CommandOutput --|> UiPart
NextEventCard --|> UiPart
CommuteStatusCard --|> UiPart
RouteAlternativesPanel --|> UiPart
MainWindow *--> DashboardHeader
MainWindow *--> CommandBar
MainWindow *--> CommandOutput
MainWindow *--> NextEventCard
MainWindow *--> CommuteStatusCard
MainWindow *--> RouteAlternativesPanel
MainWindow --> DashboardState : renders
CommandLineApp *--> TimeyModel
CommandLineApp --> Command
CommandLineApp *--> Parser
TimeyModel --> PlanCommand
TimeyModel --> RouteAlternative
TimeyModel --> DepartureRecommendation
TimeyModel --> Planner
ThanksCommand --|> Command
AddCommand --|> Command
PlanCommand --|> Command
ChooseCommand --|> Command
UnknownCommand --|> Command
Command --> TimeyModel
Command --> CommandResult : creates
AddCommand --> TimeyModel
ChooseCommand --> TimeyModel
TimeyModel --> FixedCommuteStore
TimeyModel --> FixedCommute : creates
TimeyModel --> RouteSelectionResult : creates
RouteSelectionResult --> RouteSelectionStatus
RouteSelectionResult --> DepartureRecommendation : optional

' Command interpretation
Parser *--> PlanCommandParser
Parser *--> AddCommandParser
Parser --> Command : creates
PlanCommandParser --> PlanCommand : creates
AddCommandParser --> AddCommand : creates

' Application services
Planner --> CommutePlanningService
Planner --> LocationResolver
Planner *--> LiveRailPlanningService
Planner --> PlanCommand
Planner --> DepartureRecommendation
Planner --> PlanningResult : creates
PlanningResult --> RouteAlternative
LiveRailPlanningService --> RailTransitPlanner
LiveRailPlanningService *--> DepartureCalculator
LiveRailPlanningService --> PlanCommand
LiveRailPlanningService --> ResolvedLocation
LiveRailPlanningService --> LiveRouteLookup
CommutePlanningService --> TransitPlanner
CommutePlanningService *--> DepartureCalculator
CommutePlanningService --> PlanCommand
CommutePlanningService --> RouteAlternative
CommutePlanningService --> DepartureRecommendation

' Domain value relationships and business calculation
DepartureCalculator --> PlanCommand
DepartureCalculator --> RouteAlternative
DepartureCalculator --> DepartureRecommendation : creates
LocationResolution --> ResolvedLocation : optional location
LiveRouteLookup --> RouteAlternative
RouteAlternative *--> "0..*" RouteStep
RouteStep --> RouteStepMode

' Ports and their infrastructure adapters
OneMapLocationResolver ..|> LocationResolver
MockTransitPlanner ..|> TransitPlanner
OneMapRailTransitPlanner ..|> RailTransitPlanner
JdkHttpRequester ..|> HttpRequester
RetryingHttpRequester ..|> HttpRequester

OneMapLocationResolver --> HttpRequester
OneMapLocationResolver --> LocationResolution
OneMapLocationResolver --> ResolvedLocation : creates
OneMapRailTransitPlanner --> HttpRequester
OneMapRailTransitPlanner --> ResolvedLocation
OneMapRailTransitPlanner --> LiveRouteLookup : creates
OneMapRailTransitPlanner --> RouteAlternative : creates
OneMapRailTransitPlanner --> RouteStep : creates
OneMapRailTransitPlanner --> RouteStepMode
MockTransitPlanner --> RouteAlternative
HttpRequester --> HttpResult
RetryingHttpRequester --> HttpRequester : delegates to
RetryingHttpRequester --> RetryDelay
JdkHttpRequester --> HttpResult : creates

note bottom
  Scope: production types under src/main/java/Timey.
end note
@enduml
