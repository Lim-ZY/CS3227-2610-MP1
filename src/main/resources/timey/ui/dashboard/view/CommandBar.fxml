<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="command-bar"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets bottom="24.0" left="56.0" right="56.0" top="24.0" />
  </padding>
  <children>
    <Label styleClass="command-prompt" text="&gt;" />
    <TextField styleClass="command-prompt" fx:id="commandTextField" onAction="#handleCommandEntered"
               promptText="Tell me what to do! Call `help` if you're lost!"
               HBox.hgrow="ALWAYS" />
  </children>
</HBox>
