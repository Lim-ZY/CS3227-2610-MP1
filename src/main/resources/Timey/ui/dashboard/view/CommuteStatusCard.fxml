<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="136.0" spacing="10.0" styleClass="card"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label styleClass="card-label" text="COMMUTE STATUS" />
    <Label fx:id="title" styleClass="card-title" text="Waiting for a plan" />
    <Label fx:id="message" styleClass="muted" text="Live rail alternatives are requested only after you plan a commute."
           wrapText="true" />
  </children>
</VBox>
